import cupynumeric as np
import numpy as host_np

def init(T, N):
    lower = np.ones(N, dtype=T)
    diagonal = np.full(N, T(4), dtype=T)
    upper = np.ones(N, dtype=T)
    x = np.zeros(N, dtype=T)
    r = np.zeros(N, dtype=T)
    p = np.zeros(N, dtype=T)
    Ap = np.zeros(N, dtype=T)
    return {"A": (lower, diagonal, upper), "x": x, "work": (r, p, Ap)}

def run(state, T, N, check_every=10, max_iter=1000):
    lower, diagonal, upper = state["A"]
    x = state["x"]
    r, p, Ap = state["work"]
    tiny = T(host_np.finfo(T).tiny)
    x[:] = T(0)
    r[:] = T(0.5)
    p[:] = r
    rho = np.sum(r * r)
    target = (1e-5 if T is np.float32 else 1e-8) ** 2 * N / 4
    for k in range(1, max_iter + 1):
        Ap[:] = diagonal * p
        Ap[1:] += lower[1:] * p[:-1]
        Ap[:-1] += upper[:-1] * p[1:]
        alpha = rho / np.maximum(np.sum(p * Ap), tiny)
        x += alpha * p
        r -= alpha * Ap
        nxt = np.sum(r * r)
        p[:] = r + (nxt / np.maximum(rho, tiny)) * p
        rho = nxt
        if k % check_every == 0 or k == max_iter:
            if float(rho) <= target:
                return k
    return max_iter
