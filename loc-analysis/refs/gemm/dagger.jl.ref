using CUDA: CUDA
using Dagger: Dagger
using LinearAlgebra

wait_for_darray(array) = (foreach(wait, array.chunks); array)

function init(T, N, M, gpus)
    scope = Dagger.scope(; cuda_gpus=collect(1:gpus))
    procs = sort!(collect(Dagger.compatible_processors(scope)); by=string)
    block = cld(N, gpus)
    nb = cld(N, block)
    owner(i) = procs[cld(i * gpus, nb)]
    return Dagger.with_options(; scope) do
        A = rand(Dagger.Blocks(block, M), T, N, M;
            assignment=reshape([owner(i) for i in 1:nb], nb, 1))
        B = rand(Dagger.Blocks(M, block), T, M, N;
            assignment=reshape([owner(j) for j in 1:nb], 1, nb))
        C = zeros(Dagger.Blocks(block, block), T, N, N;
            assignment=[owner(j) for _ in 1:nb, j in 1:nb])
        foreach(wait_for_darray, (C, A, B))
        return (; scope, C, A, B)
    end
end

function run!(s)
    Dagger.with_options(; scope=s.scope) do
        return mul!(s.C, s.A, s.B)
    end
    return wait_for_darray(s.C)
end
