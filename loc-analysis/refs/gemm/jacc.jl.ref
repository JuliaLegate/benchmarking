using JACC: JACC
JACC.@init_backend

function init(T, N, M, gpus)
    A = rand(T, N, M)
    B = rand(T, M, N)
    C = zeros(T, N, N)
    # MultiArray partitions by columns; replicate A so every GPU holds all of it.
    return JACC.Multi.array(C), JACC.Multi.array(repeat(A, 1, gpus)), JACC.Multi.array(B)
end

@inline function gemm_kernel(i, j, C, A, B, inner)
    acc = @inbounds A[i, 1] * B[1, j]
    for k in 2:inner
        acc = @inbounds muladd(A[i, k], B[k, j], acc)
    end
    @inbounds C[i, j] = acc
    return nothing
end

run!(C, A, B, N, M) = JACC.Multi.parallel_for((N, N), gemm_kernel, C, A, B, M)
