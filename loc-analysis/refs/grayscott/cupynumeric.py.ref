import cupynumeric as np

def params(T):
    return dict(dx=T(1.0), dt=T(1.0 / 5), c_u=T(1.0), c_v=T(0.3), f=T(0.03), k=T(0.06))

def init(T, N, M):
    u = np.ones((N, M), dtype=T)
    v = np.zeros((N, M), dtype=T)
    u_new = np.zeros((N, M), dtype=T)
    v_new = np.zeros((N, M), dtype=T)
    seed = min(150, N, M)
    u[:seed, :seed] = np.random.rand(seed, seed).astype(T)
    v[:seed, :seed] = np.random.rand(seed, seed).astype(T)
    return [u, v, u_new, v_new]

def run(state, p):
    u, v, u_new, v_new = state
    ui = u[1:-1, 1:-1]
    vi = v[1:-1, 1:-1]

    F_u = (-ui * (vi * vi)) + p["f"] * (1 - ui)
    F_v = (ui * (vi * vi)) - (p["f"] + p["k"]) * vi

    dx2 = p["dx"] * p["dx"]
    u_lap = (
        (u[2:, 1:-1] - 2 * ui + u[:-2, 1:-1]) / dx2
        + (u[1:-1, 2:] - 2 * ui + u[1:-1, :-2]) / dx2
    )
    v_lap = (
        (v[2:, 1:-1] - 2 * vi + v[:-2, 1:-1]) / dx2
        + (v[1:-1, 2:] - 2 * vi + v[1:-1, :-2]) / dx2
    )

    u_new[1:-1, 1:-1] = (p["c_u"] * u_lap + F_u) * p["dt"] + ui
    v_new[1:-1, 1:-1] = (p["c_v"] * v_lap + F_v) * p["dt"] + vi

    u_new[:, 0] = u[:, -2]
    u_new[:, -1] = u[:, 1]
    u_new[0, :] = u[-2, :]
    u_new[-1, :] = u[1, :]
    v_new[:, 0] = v[:, -2]
    v_new[:, -1] = v[:, 1]
    v_new[0, :] = v[-2, :]
    v_new[-1, :] = v[1, :]

    state[0], state[2] = u_new, u
    state[1], state[3] = v_new, v
