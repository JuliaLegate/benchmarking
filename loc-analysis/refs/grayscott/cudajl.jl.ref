using CUDA

params(T) = (; dx=T(1), dt=T(1 / 5), c_u=T(1.0), c_v=T(0.3), f=T(0.03), k=T(0.06))

function init(T, N, M)
    u = CUDA.ones(T, N, M)
    v = CUDA.zeros(T, N, M)
    u_new = CUDA.zeros(T, N, M)
    v_new = CUDA.zeros(T, N, M)
    F_u = CUDA.zeros(T, N - 2, M - 2)
    F_v = CUDA.zeros(T, N - 2, M - 2)
    u_lap = CUDA.zeros(T, N - 2, M - 2)
    v_lap = CUDA.zeros(T, N - 2, M - 2)
    seed = min(150, N, M)
    u[1:seed, 1:seed] = CUDA.rand(T, seed, seed)
    v[1:seed, 1:seed] = CUDA.rand(T, seed, seed)
    return [u, v, u_new, v_new, F_u, F_v, u_lap, v_lap]
end

@views function gs_step!(u, v, u_new, v_new, F_u, F_v, u_lap, v_lap, args)
    F_u .= (
        (
            .-u[2:(end - 1), 2:(end - 1)] .*
            (v[2:(end - 1), 2:(end - 1)] .* v[2:(end - 1), 2:(end - 1)])
        ) .+ args.f .* (1.0f0 .- u[2:(end - 1), 2:(end - 1)])
    )
    F_v .= (
        (
            u[2:(end - 1), 2:(end - 1)] .*
            (v[2:(end - 1), 2:(end - 1)] .* v[2:(end - 1), 2:(end - 1)])
        ) .- (args.f + args.k) .* v[2:(end - 1), 2:(end - 1)]
    )
    u_lap .= (
        (
            u[3:end, 2:(end - 1)] .- 2 .* u[2:(end - 1), 2:(end - 1)] .+
            u[1:(end - 2), 2:(end - 1)]
        ) ./ args.dx^2 .+
        (
            u[2:(end - 1), 3:end] .- 2 .* u[2:(end - 1), 2:(end - 1)] .+
            u[2:(end - 1), 1:(end - 2)]
        ) ./ args.dx^2
    )
    v_lap .= (
        (
            v[3:end, 2:(end - 1)] .- 2 .* v[2:(end - 1), 2:(end - 1)] .+
            v[1:(end - 2), 2:(end - 1)]
        ) ./ args.dx^2 .+
        (
            v[2:(end - 1), 3:end] .- 2 .* v[2:(end - 1), 2:(end - 1)] .+
            v[2:(end - 1), 1:(end - 2)]
        ) ./ args.dx^2
    )
    u_new[2:(end - 1), 2:(end - 1)] .=
        ((args.c_u .* u_lap) .+ F_u) .* args.dt .+ u[2:(end - 1), 2:(end - 1)]
    v_new[2:(end - 1), 2:(end - 1)] .=
        ((args.c_v .* v_lap) .+ F_v) .* args.dt .+ v[2:(end - 1), 2:(end - 1)]
    u_new[:, 1] .= u[:, end - 1]
    u_new[:, end] .= u[:, 2]
    u_new[1, :] .= u[end - 1, :]
    u_new[end, :] .= u[2, :]
    v_new[:, 1] .= v[:, end - 1]
    v_new[:, end] .= v[:, 2]
    v_new[1, :] .= v[end - 1, :]
    v_new[end, :] .= v[2, :]
end

function run!(s, args)
    u, v, u_new, v_new, F_u, F_v, u_lap, v_lap = s
    gs_step!(u, v, u_new, v_new, F_u, F_v, u_lap, v_lap, args)
    s[1], s[3] = u_new, u
    s[2], s[4] = v_new, v
    return nothing
end
