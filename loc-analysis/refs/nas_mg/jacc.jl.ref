using JACC: JACC
JACC.@init_backend

const NAS_MG_A = (-8.0/3.0, 0.0, 1.0/6.0, 1.0/12.0)

function nas_mg_level_shapes(p)
    d = p.dims
    lt = round(Int, log2(minimum(d)))
    return [d .÷ 2^(lt - level) .+ 2 for level in 1:lt]
end

struct MGLayout
    nx::Int
    ny::Int
    nz::Int
    P::Int
    rep::Bool
end

MGLayout(shape::NTuple{3,Int}, P, rep) = MGLayout(shape..., P, rep)
mg_plane(L::MGLayout) = L.nx*L.ny

mg_cols(L::MGLayout, ndev) = L.rep ? ndev*L.nz : ndev*L.P

@inline mg_k(a, L::MGLayout, jl) = L.rep ? jl : (a.dev_id - 1)*L.P + jl

@inline function mg_col(a, L::MGLayout, k)
    L.rep && return k
    shift = a.dev_id > 1 && a.ghost_dims > 0 ? 1 : 0
    return k - (a.dev_id - 1)*L.P + shift
end

@inline mg_at(a, L::MGLayout, i, j, k) = i + L.nx*(j - 1) + mg_plane(L)*(mg_col(a, L, k) - 1)

function mg_multi_plan(shapes, ndev)
    nlev = length(shapes)
    nz = [shape[3] for shape in shapes]
    for lt in 1:nlev
        P = max(2, cld(nz[lt], ndev))
        ndev*P*2^(nlev - lt) <= 1.10*nz[end] || continue
        return [l < lt ? MGLayout(shapes[l], 0, true) :
                MGLayout(shapes[l], P*2^(l - lt), false) for l in 1:nlev]
    end
    return [l < nlev ? MGLayout(shapes[l], 0, true) :
            MGLayout(shapes[l], cld(nz[l], ndev), false) for l in 1:nlev]
end

function mg_multi_alloc(L::MGLayout, ndev, host=nothing)
    cols = mg_cols(L, ndev)
    x = zeros(Float64, mg_plane(L), cols)
    if host !== nothing
        x[:, 1:L.nz] .= reshape(host, mg_plane(L), L.nz)
    end
    return JACC.Multi.array(x; ghost_dims=L.rep ? 0 : 1)
end

mg_launch(m, cols, f, args...) = JACC.Multi.parallel_for((m, cols), f, args...)
mg_for(L::MGLayout, m, f, args...) = mg_launch(m, mg_cols(L, JACC.Multi.ndev()), f, args...)

@inline function mgm_zero(q, jl, out, plane)
    col = q + plane*(jl - 1)
    col <= length(out) && (@inbounds out[col] = 0.0)
    return nothing
end

function mgm_fill!(out, L)
    cols = L.rep ? L.nz : L.P + 2
    return mg_launch(mg_plane(L), JACC.Multi.ndev()*cols, mgm_zero, out, mg_plane(L))
end

@inline function mgm_comm_x(q, jl, out, L)
    k = mg_k(out, L, jl)
    if 2 <= k <= L.nz - 1
        j, nx = q + 1, L.nx
        @inbounds begin
            out[mg_at(out, L, 1, j, k)] = out[mg_at(out, L, nx - 1, j, k)]
            out[mg_at(out, L, nx, j, k)] = out[mg_at(out, L, 2, j, k)]
        end
    end
    return nothing
end

@inline function mgm_comm_y(q, jl, out, L)
    k = mg_k(out, L, jl)
    if 2 <= k <= L.nz - 1
        ny = L.ny
        @inbounds begin
            out[mg_at(out, L, q, 1, k)] = out[mg_at(out, L, q, ny - 1, k)]
            out[mg_at(out, L, q, ny, k)] = out[mg_at(out, L, q, 2, k)]
        end
    end
    return nothing
end

@inline function mgm_comm_z_local(q, _, out, L)
    nz = L.nz
    i, j = (q - 1) % L.nx + 1, (q - 1) ÷ L.nx + 1
    @inbounds begin
        out[mg_at(out, L, i, j, 1)] = out[mg_at(out, L, i, j, nz - 1)]
        out[mg_at(out, L, i, j, nz)] = out[mg_at(out, L, i, j, 2)]
    end
    return nothing
end

mg_owner(L::MGLayout, k) = cld(k, L.P)

function mg_plane_offset(L::MGLayout, d, k)
    shift = d > 1 && L.P > 0 ? 1 : 0
    return (k - (d - 1)*L.P + shift - 1)*mg_plane(L) + 1
end

function mgm_comm_z_slab!(out, L)
    nz, plane = L.nz, mg_plane(L)
    ps = out.a2
    for (dst, src) in ((1, nz - 1), (nz, 2))
        dd, ds = mg_owner(L, dst), mg_owner(L, src)
        doff = mg_plane_offset(L, dd, dst)
        soff = mg_plane_offset(L, ds, src)
        multi_copy!(ps[dd], dd, doff, ps[ds], ds, soff, plane)
    end
    return JACC.Multi.sync_ghost_elems!(out)
end

function mgm_comm3!(out, L)
    mg_for(L, L.ny - 2, mgm_comm_x, out, L)
    mg_for(L, L.nx, mgm_comm_y, out, L)
    if L.rep
        mg_launch(mg_plane(L), JACC.Multi.ndev(), mgm_comm_z_local, out, L)
    else
        mgm_comm_z_slab!(out, L)
    end
    return out
end

@inline function mgm_interior(q, nx)
    return (q - 1) % (nx - 2) + 2, (q - 1) ÷ (nx - 2) + 2
end

mg_interior_items(L::MGLayout) = (L.nx - 2)*(L.ny - 2)

@inline function mgm_resid(q, jl, r, u, v, L)
    k = mg_k(r, L, jl)
    (2 <= k <= L.nz - 1) || return nothing
    i, j = mgm_interior(q, L.nx)
    c, n, n2 = mg_at(r, L, i, j, k), L.nx, mg_plane(L)
    U(di, dj, dk) = @inbounds u[c + di + n*dj + n2*dk]
    @inbounds r[c] =
        v[c] - NAS_MG_A[1]*U(0, 0, 0) -
        NAS_MG_A[3] * (
            U(0, -1, -1) + U(0, 1, -1) + U(0, -1, 1) + U(0, 1, 1) +
            U(-1, 0, -1) + U(1, 0, -1) + U(-1, 0, 1) + U(1, 0, 1) +
            U(-1, -1, 0) + U(1, -1, 0) + U(-1, 1, 0) + U(1, 1, 0)
        ) -
        NAS_MG_A[4] * (
            U(-1, -1, -1) + U(1, -1, -1) + U(-1, 1, -1) + U(1, 1, -1) +
            U(-1, -1, 1) + U(1, -1, 1) + U(-1, 1, 1) + U(1, 1, 1)
        )
    return nothing
end

function mgm_resid!(r, u, v, L)
    mg_for(L, mg_interior_items(L), mgm_resid, r, u, v, L)
    return mgm_comm3!(r, L)
end

@inline function mgm_psinv(q, jl, u, r, L, c)
    k = mg_k(u, L, jl)
    (2 <= k <= L.nz - 1) || return nothing
    i, j = mgm_interior(q, L.nx)
    ci, n, n2 = mg_at(u, L, i, j, k), L.nx, mg_plane(L)
    R(di, dj, dk) = @inbounds r[ci + di + n*dj + n2*dk]
    @inbounds u[ci] +=
        c[1]*R(0, 0, 0) +
        c[2]*(R(-1, 0, 0) + R(1, 0, 0) + R(0, -1, 0) + R(0, 1, 0) + R(0, 0, -1) + R(0, 0, 1)) +
        c[3] * (
            R(0, -1, -1) + R(0, 1, -1) + R(0, -1, 1) + R(0, 1, 1) +
            R(-1, 0, -1) + R(1, 0, -1) + R(-1, 0, 1) + R(1, 0, 1) +
            R(-1, -1, 0) + R(1, -1, 0) + R(-1, 1, 0) + R(1, 1, 0)
        )
    return nothing
end

function mgm_psinv!(u, r, L, c)
    mg_for(L, mg_interior_items(L), mgm_psinv, u, r, L, c)
    return mgm_comm3!(u, L)
end

@inline function mgm_restrict(q, jl, coarse, fine, Lc, Lf)
    k = mg_k(coarse, Lc, jl)
    (2 <= k <= Lc.nz - 1) || return nothing
    i, j = mgm_interior(q, Lc.nx)
    fi, fj, fk = 2i - 1, 2j - 1, 2k - 1
    fc, n, n2 = mg_at(fine, Lf, fi, fj, fk), Lf.nx, mg_plane(Lf)
    F(di, dj, dk) = @inbounds fine[fc + di + n*dj + n2*dk]
    @inbounds coarse[mg_at(coarse, Lc, i, j, k)] =
        0.5*F(0, 0, 0) +
        0.25*(F(-1, 0, 0) + F(1, 0, 0) + F(0, -1, 0) + F(0, 1, 0) + F(0, 0, -1) + F(0, 0, 1)) +
        0.125 * (
            F(0, -1, -1) + F(0, 1, -1) + F(0, -1, 1) + F(0, 1, 1) +
            F(-1, 0, -1) + F(1, 0, -1) + F(-1, 0, 1) + F(1, 0, 1) +
            F(-1, -1, 0) + F(1, -1, 0) + F(-1, 1, 0) + F(1, 1, 0)
        ) +
        0.0625 * (
            F(-1, -1, -1) + F(1, -1, -1) + F(-1, 1, -1) + F(1, 1, -1) +
            F(-1, -1, 1) + F(1, -1, 1) + F(-1, 1, 1) + F(1, 1, 1)
        )
    return nothing
end

function mgm_restrict!(coarse, fine, Lc, Lf)
    mg_for(Lc, mg_interior_items(Lc), mgm_restrict, coarse, fine, Lc, Lf)
    return mgm_comm3!(coarse, Lc)
end

@inline mgm_lerp(a, b, weight) = muladd(weight, b - a, a)

@inline function mgm_interp(q, jl, fine, coarse, Lf, Lc)
    k = mg_k(fine, Lf, jl)
    k <= Lf.nz || return nothing
    i, j = (q - 1) % Lf.nx + 1, (q - 1) ÷ Lf.nx + 1
    qi, qj, qk = i - 1, j - 1, k - 1
    i0, j0, k0 = qi ÷ 2 + 1, qj ÷ 2 + 1, qk ÷ 2 + 1
    i1, j1, k1 = i0 + (qi % 2), j0 + (qj % 2), k0 + (qk % 2)
    wi, wj, wk = 0.5*(qi % 2), 0.5*(qj % 2), 0.5*(qk % 2)
    base = mg_at(coarse, Lc, i0, j0, k0)
    di, dj, dk = i1 - i0, Lc.nx*(j1 - j0), mg_plane(Lc)*(k1 - k0)
    C(a, b, c) = @inbounds coarse[base + a + b + c]
    z00 = mgm_lerp(C(0, 0, 0), C(di, 0, 0), wi)
    z10 = mgm_lerp(C(0, dj, 0), C(di, dj, 0), wi)
    z01 = mgm_lerp(C(0, 0, dk), C(di, 0, dk), wi)
    z11 = mgm_lerp(C(0, dj, dk), C(di, dj, dk), wi)
    @inbounds fine[mg_at(fine, Lf, i, j, k)] +=
        mgm_lerp(mgm_lerp(z00, z10, wj), mgm_lerp(z01, z11, wj), wk)
    return nothing
end

function mgm_interp!(fine, coarse, Lf, Lc)
    mg_for(Lf, mg_plane(Lf), mgm_interp, fine, coarse, Lf, Lc)
    Lf.rep || JACC.Multi.sync_ghost_elems!(fine)
    return fine
end

@inline function mgm_norm_term(q, jl, r, L)
    k = mg_k(r, L, jl)
    (2 <= k <= L.nz - 1) || return 0.0
    i, j = mgm_interior(q, L.nx)
    return @inbounds abs2(r[mg_at(r, L, i, j, k)])
end

function mgm_gather!(dest, src, L)
    host = JACC.to_host(src)
    points = mg_plane(L)*L.nz
    for (d, part) in enumerate(dest.a2)
        multi_upload!(part, d, host, points)
    end
    return dest
end

mg_replicated(L::MGLayout) = MGLayout(L.nx, L.ny, L.nz, 0, true)

function init(p)
    nd = JACC.Multi.ndev()
    layouts = mg_multi_plan(nas_mg_level_shapes(p), nd)
    u = Any[mg_multi_alloc(L, nd) for L in layouts]
    r = Any[mg_multi_alloc(L, nd) for L in layouts]
    rhs = mg_multi_alloc(layouts[end], nd, nas_mg_rhs(p))
    lt = findfirst(L -> !L.rep, layouts)
    gathered = lt > 1 ? mg_multi_alloc(mg_replicated(layouts[lt]), nd) : nothing
    return (; layouts, u, r, rhs, gathered)
end

function mgm_cycle!(s, c)
    Ls = s.layouts
    finest = length(Ls)
    for level in finest:-1:2
        Lf, Lc = Ls[level], Ls[level - 1]
        if Lc.rep && !Lf.rep
            G = mg_replicated(Lf)
            mgm_gather!(s.gathered, s.r[level], Lf)
            mgm_restrict!(s.r[level - 1], s.gathered, Lc, G)
        else
            mgm_restrict!(s.r[level - 1], s.r[level], Lc, Lf)
        end
    end
    mgm_fill!(s.u[1], Ls[1])
    mgm_psinv!(s.u[1], s.r[1], Ls[1], c)
    for level in 2:(finest - 1)
        L = Ls[level]
        mgm_fill!(s.u[level], L)
        mgm_interp!(s.u[level], s.u[level - 1], L, Ls[level - 1])
        mgm_resid!(s.r[level], s.u[level], s.r[level], L)
        mgm_psinv!(s.u[level], s.r[level], L, c)
    end
    L = Ls[end]
    mgm_interp!(s.u[end], s.u[end - 1], L, Ls[end - 1])
    mgm_resid!(s.r[end], s.u[end], s.rhs, L)
    mgm_psinv!(s.u[end], s.r[end], L, c)
    return nothing
end

function run!(s, p)
    L = s.layouts[end]
    foreach(((u, Lu),) -> mgm_fill!(u, Lu), zip(s.u, s.layouts))
    mgm_resid!(s.r[end], s.u[end], s.rhs, L)
    mg_reduce(L, mg_interior_items(L), mgm_norm_term, s.r[end], L)
    for _ in 1:p.niter
        mgm_cycle!(s, p.c)
        mgm_resid!(s.r[end], s.u[end], s.rhs, L)
    end
    return mg_reduce(L, mg_interior_items(L), mgm_norm_term, s.r[end], L)
end

mg_reduce(L::MGLayout, m, f, args...) =
    JACC.Multi.parallel_reduce((m, mg_cols(L, JACC.Multi.ndev())), f, args...)
