using JACC: JACC
JACC.@init_backend

init(T, n) = JACC.Multi.array(T(10) .* rand(T, n))

@inline function integrand(i, samples)
    x = @inbounds samples[i]
    return exp(-(x * x))
end

function run(samples, T, n)
    integral = JACC.Multi.parallel_reduce(n, integrand, samples)
    return (T(10) / n) * integral
end
