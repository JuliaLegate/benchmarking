using CUDA: CUDA
using Dagger: Dagger
using AbstractFFTs

const NAS_FT_ALPHA = 1.0e-6
const NAS_FT_CHECKSUM_SAMPLES = 1024

function nas_ft_checksum_indices(p)
    linear = LinearIndices((p.nx, p.ny, p.nz))
    return [
        linear[mod(j, p.nx) + 1, mod(3j, p.ny) + 1, mod(5j, p.nz) + 1]
        for j in 1:NAS_FT_CHECKSUM_SAMPLES
    ]
end

function nas_ft_checksum_mask(p)
    mask = zeros(Float64, p.nx, p.ny, p.nz)
    @inbounds for index in nas_ft_checksum_indices(p)
        mask[index] += 1.0
    end
    return mask
end

function host_twiddle!(out, frequency_squares)
    ix2, iy2, iz2 = frequency_squares
    ap = -4.0*NAS_FT_ALPHA*pi^2
    Threads.@threads for k in eachindex(iz2)
        z = iz2[k]
        @inbounds for j in eachindex(iy2), i in eachindex(ix2)
            out[i, j, k] = exp(ap*(ix2[i] + iy2[j] + z))
        end
    end
    return out
end

chunk_checksum(values, mask) =
    mapreduce(*, +, values, mask; dims=ntuple(identity, ndims(values)), init=zero(eltype(values)))

function checksum_tasks(s)
    tasks = Vector{Dagger.DTask}(undef, length(s.u1.chunks))
    Dagger.spawn_datadeps() do
        for i in eachindex(tasks)
            tasks[i] = Dagger.@spawn scope=Dagger.ExactScope(s.procs[i]) chunk_checksum(
                Dagger.In(s.u1.chunks[i]), Dagger.In(s.mask.chunks[i])
            )
        end
    end
    return tasks
end

function init(p, gpus)
    scope = Dagger.scope(; cuda_gpus=collect(1:gpus))
    procs = sort!(collect(Dagger.compatible_processors(scope)); by=string)
    shape = (p.nx, p.ny, p.nz)
    block = cld(p.nz, gpus)
    blocks = Dagger.Blocks(p.nx, p.ny, block)
    assignment = reshape(procs, 1, 1, gpus)
    host = Array{ComplexF64}(undef, shape)
    scratch = Vector{UInt64}(undef, min(2length(host), 1 << 20))
    nas_ft_initial_conditions_uint64!(host, scratch)
    frequency_squares = ntuple(d -> Float64[
        ((i + shape[d]÷2) % shape[d] - shape[d]÷2)^2 for i in 0:(shape[d] - 1)
    ], 3)
    host_twiddle = host_twiddle!(Array{Float64}(undef, shape), frequency_squares)
    return Dagger.with_options(; scope) do
        initial = Dagger.DArray(host, blocks, assignment)
        u0 = Dagger.DArray(zeros(ComplexF64, shape), blocks, assignment)
        u1 = Dagger.DArray(zeros(ComplexF64, shape), blocks, assignment)
        twiddle = Dagger.DArray(host_twiddle, blocks, assignment)
        mask = Dagger.DArray(nas_ft_checksum_mask(p), blocks, assignment)
        return (; scope, procs, initial, u0, u1, twiddle, mask)
    end
end

function run!(s, p)
    return Dagger.with_options(; scope=s.scope) do
        copyto!(s.u0, s.initial)
        fft!(s.u0, (1, 2, 3); decomp=:slab)
        checksums = ComplexF64[]
        for _ in 1:p.niter
            s.u0 .*= s.twiddle
            copyto!(s.u1, s.u0)
            ifft!(s.u1, (1, 2, 3); decomp=:slab)
            push!(checksums, sum(task -> only(fetch(task)), checksum_tasks(s)))
        end
        return checksums
    end
end
