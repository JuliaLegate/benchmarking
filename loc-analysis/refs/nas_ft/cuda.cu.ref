#include <cuda_runtime.h>
#include <cmath>
#include <cstdlib>
#include "npbparams.hpp"
#include <omp.h>

typedef struct {
    double real;
    double imag;
} dcomplex;
#define dcomplex_create(r, i) (dcomplex){r, i}
#define dcomplex_add(a, b) (dcomplex){(a).real+(b).real, (a).imag+(b).imag}
#define dcomplex_mul2(a, b) (dcomplex){(a).real*(b), (a).imag*(b)}

#define PI (3.141592653589793238)
#define ALPHA (1.0e-6)
#define AP (-4.0 * ALPHA * PI * PI)
#define OMP_THREADS (3)
#define TASK_INDEXMAP (0)
#define TASK_INITIAL_CONDITIONS (1)
#define TASK_INIT_UI (2)
#define CHECKSUM_TASKS (1024)

static dcomplex(*u) = (dcomplex *)malloc(sizeof(dcomplex) * (MAXDIM));
static int niter;

double *starts_device, *twiddle_device;
dcomplex *sums_device, *u_device, *u0_device, *u1_device, *y0_device, *y1_device;
size_t size_sums_device, size_starts_device, size_twiddle_device, size_u_device, size_u0_device, size_u1_device, size_y0_device, size_y1_device, size_shared_data;
int blocks_per_grid_on_compute_indexmap, blocks_per_grid_on_compute_initial_conditions, blocks_per_grid_on_init_ui, blocks_per_grid_on_evolve, blocks_per_grid_on_fftx_1, blocks_per_grid_on_fftx_2, blocks_per_grid_on_fftx_3, blocks_per_grid_on_ffty_1, blocks_per_grid_on_ffty_2, blocks_per_grid_on_ffty_3, blocks_per_grid_on_fftz_1, blocks_per_grid_on_fftz_2, blocks_per_grid_on_fftz_3, blocks_per_grid_on_checksum, threads_per_block_on_compute_indexmap, threads_per_block_on_compute_initial_conditions, threads_per_block_on_init_ui, threads_per_block_on_evolve, threads_per_block_on_fftx_1, threads_per_block_on_fftx_2, threads_per_block_on_fftx_3, threads_per_block_on_ffty_1, threads_per_block_on_ffty_2, threads_per_block_on_ffty_3, threads_per_block_on_fftz_1, threads_per_block_on_fftz_2, threads_per_block_on_fftz_3, threads_per_block_on_checksum;
extern __shared__ double extern_share_data[];

int main() {
    int iter = 0;
    niter = NITER_DEFAULT;
    setup_gpu();
    init_ui_gpu(u0_device, u1_device, twiddle_device);
#pragma omp parallel
    {
        if (omp_get_thread_num() == TASK_INDEXMAP) {
            compute_indexmap_gpu(twiddle_device);
        } else if (omp_get_thread_num() == TASK_INITIAL_CONDITIONS) {
            compute_initial_conditions_gpu(u1_device);
        } else if (omp_get_thread_num() == TASK_INIT_UI) {
            fft_init_gpu(MAXDIM);
        }
    }
    cudaDeviceSynchronize();
    fft_gpu(1, u1_device, u0_device);
    for (iter = 1; iter <= niter; iter++) {
        evolve_gpu(u0_device, u1_device, twiddle_device);
        fft_gpu(-1, u1_device, u1_device);
        checksum_gpu(iter, u1_device);
    }

    return 0;
}

static void cffts1_gpu(const int is, dcomplex u[], dcomplex x_in[], dcomplex x_out[], dcomplex y0[], dcomplex y1[]) {
    cffts1_gpu_kernel_1<<<blocks_per_grid_on_fftx_1, threads_per_block_on_fftx_1>>>(x_in, y0);

    cffts1_gpu_kernel_2<<<blocks_per_grid_on_fftx_2, threads_per_block_on_fftx_2>>>(is, y0, y1, u);

    cffts1_gpu_kernel_3<<<blocks_per_grid_on_fftx_3, threads_per_block_on_fftx_3>>>(x_out, y0);
}

__global__ void cffts1_gpu_kernel_1(dcomplex x_in[], dcomplex y0[]) {
    int x_y_z = blockIdx.x * blockDim.x + threadIdx.x;
    if (x_y_z >= (NX * NY * NZ)) {
        return;
    }
    int x = x_y_z % NX, y = (x_y_z / NX) % NY, z = x_y_z / (NX * NY);
    y0[y + (x * NY) + (z * NX * NY)].real = x_in[x_y_z].real;
    y0[y + (x * NY) + (z * NX * NY)].imag = x_in[x_y_z].imag;
}

__global__ void cffts1_gpu_kernel_2(const int is, dcomplex gty1[], dcomplex gty2[], dcomplex u_device[]) {
    int y_z = blockIdx.x * blockDim.x + threadIdx.x;

    if (y_z >= (NY * NZ)) {
        return;
    }

    int j, k, l, j1, i1, k1, n1, li, lj, lk, ku, i11, i12, i21, i22;

    j = y_z % NY;
    k = (y_z / NY) % NZ;

    const int logd1 = ilog2_device(NX);

    double uu1_real, x11_real, x21_real, uu1_imag, x11_imag, x21_imag, uu2_real, x12_real, x22_real, uu2_imag, x12_imag, x22_imag, temp_real, temp2_real, temp_imag, temp2_imag;

    for (l = 1; l <= logd1; l += 2) {
        n1 = NX / 2;
        lk = 1 << (l - 1);
        li = 1 << (logd1 - l);
        lj = 2 * lk;
        ku = li;
        for (i1 = 0; i1 <= li - 1; i1++) {
            for (k1 = 0; k1 <= lk - 1; k1++) {
                i11 = i1 * lk;
                i12 = i11 + n1;
                i21 = i1 * lj;
                i22 = i21 + lk;

                uu1_real = u_device[ku + i1].real;
                uu1_imag = is * u_device[ku + i1].imag;

                x11_real = gty1[j + (i11 + k1) * NY + k * NX * NY].real;
                x11_imag = gty1[j + (i11 + k1) * NY + k * NX * NY].imag;

                x21_real = gty1[j + (i12 + k1) * NY + k * NX * NY].real;
                x21_imag = gty1[j + (i12 + k1) * NY + k * NX * NY].imag;

                gty2[j + (i21 + k1) * NY + k * NX * NY].real = x11_real + x21_real;
                gty2[j + (i21 + k1) * NY + k * NX * NY].imag = x11_imag + x21_imag;

                temp_real = x11_real - x21_real;
                temp_imag = x11_imag - x21_imag;

                gty2[j + (i22 + k1) * NY + k * NX * NY].real = (uu1_real) * (temp_real) - (uu1_imag) * (temp_imag);
                gty2[j + (i22 + k1) * NY + k * NX * NY].imag = (uu1_real) * (temp_imag) + (uu1_imag) * (temp_real);
            }
        }
        if (l == logd1) {
            for (j1 = 0; j1 < NX; j1++) {

                gty1[j + j1 * NY + k * NX * NY].real = gty2[j + j1 * NY + k * NX * NY].real;
                gty1[j + j1 * NY + k * NX * NY].imag = gty2[j + j1 * NY + k * NX * NY].imag;
            }
        } else {
            n1 = NX / 2;
            lk = 1 << (l + 1 - 1);
            li = 1 << (logd1 - (l + 1));
            lj = 2 * lk;
            ku = li;
            for (i1 = 0; i1 <= li - 1; i1++) {
                for (k1 = 0; k1 <= lk - 1; k1++) {
                    i11 = i1 * lk;
                    i12 = i11 + n1;
                    i21 = i1 * lj;
                    i22 = i21 + lk;

                    uu2_real = u_device[ku + i1].real;
                    uu2_imag = is * u_device[ku + i1].imag;

                    x12_real = gty2[j + (i11 + k1) * NY + k * NX * NY].real;
                    x12_imag = gty2[j + (i11 + k1) * NY + k * NX * NY].imag;

                    x22_real = gty2[j + (i12 + k1) * NY + k * NX * NY].real;
                    x22_imag = gty2[j + (i12 + k1) * NY + k * NX * NY].imag;

                    gty1[j + (i21 + k1) * NY + k * NX * NY].real = x12_real + x22_real;
                    gty1[j + (i21 + k1) * NY + k * NX * NY].imag = x12_imag + x22_imag;

                    temp2_real = x12_real - x22_real;
                    temp2_imag = x12_imag - x22_imag;

                    gty1[j + (i22 + k1) * NY + k * NX * NY].real = (uu2_real) * (temp2_real) - (uu2_imag) * (temp2_imag);
                    gty1[j + (i22 + k1) * NY + k * NX * NY].imag = (uu2_real) * (temp2_imag) + (uu2_imag) * (temp2_real);
                }
            }
        }
    }
}

__global__ void cffts1_gpu_kernel_3(dcomplex x_out[], dcomplex y0[]) {
    int x_y_z = blockIdx.x * blockDim.x + threadIdx.x;
    if (x_y_z >= (NX * NY * NZ)) {
        return;
    }
    int x = x_y_z % NX, y = (x_y_z / NX) % NY, z = x_y_z / (NX * NY);
    x_out[x_y_z].real = y0[y + (x * NY) + (z * NX * NY)].real;
    x_out[x_y_z].imag = y0[y + (x * NY) + (z * NX * NY)].imag;
}

static void cffts2_gpu(int is, dcomplex u[], dcomplex x_in[], dcomplex x_out[], dcomplex y0[], dcomplex y1[]) {
    cffts2_gpu_kernel_1<<<blocks_per_grid_on_ffty_1, threads_per_block_on_ffty_1>>>(x_in, y0);

    cffts2_gpu_kernel_2<<<blocks_per_grid_on_ffty_2, threads_per_block_on_ffty_2>>>(is, y0, y1, u);

    cffts2_gpu_kernel_3<<<blocks_per_grid_on_ffty_3, threads_per_block_on_ffty_3>>>(x_out, y0);
}

__global__ void cffts2_gpu_kernel_1(dcomplex x_in[], dcomplex y0[]) {
    int x_y_z = blockIdx.x * blockDim.x + threadIdx.x;
    if (x_y_z >= (NX * NY * NZ)) {
        return;
    }
    y0[x_y_z].real = x_in[x_y_z].real;
    y0[x_y_z].imag = x_in[x_y_z].imag;
}

__global__ void cffts2_gpu_kernel_2(const int is, dcomplex gty1[], dcomplex gty2[], dcomplex u_device[]) {
    int x_z = blockIdx.x * blockDim.x + threadIdx.x;

    if (x_z >= (NX * NZ)) {
        return;
    }

    int i, k, l, j1, i1, k1, n1, li, lj, lk, ku, i11, i12, i21, i22;

    i = x_z % NX;
    k = (x_z / NX) % NZ;

    const int logd2 = ilog2_device(NY);

    double uu1_real, x11_real, x21_real, uu1_imag, x11_imag, x21_imag, uu2_real, x12_real, x22_real, uu2_imag, x12_imag, x22_imag, temp_real, temp2_real, temp_imag, temp2_imag;

    for (l = 1; l <= logd2; l += 2) {
        n1 = NY / 2;
        lk = 1 << (l - 1);
        li = 1 << (logd2 - l);
        lj = 2 * lk;
        ku = li;
        for (i1 = 0; i1 <= li - 1; i1++) {
            for (k1 = 0; k1 <= lk - 1; k1++) {
                i11 = i1 * lk;
                i12 = i11 + n1;
                i21 = i1 * lj;
                i22 = i21 + lk;

                uu1_real = u_device[ku + i1].real;
                uu1_imag = is * u_device[ku + i1].imag;

                x11_real = gty1[i + (i11 + k1) * NX + k * NX * NY].real;
                x11_imag = gty1[i + (i11 + k1) * NX + k * NX * NY].imag;

                x21_real = gty1[i + (i12 + k1) * NX + k * NX * NY].real;
                x21_imag = gty1[i + (i12 + k1) * NX + k * NX * NY].imag;

                gty2[i + (i21 + k1) * NX + k * NX * NY].real = x11_real + x21_real;
                gty2[i + (i21 + k1) * NX + k * NX * NY].imag = x11_imag + x21_imag;

                temp_real = x11_real - x21_real;
                temp_imag = x11_imag - x21_imag;

                gty2[i + (i22 + k1) * NX + k * NX * NY].real = (uu1_real) * (temp_real) - (uu1_imag) * (temp_imag);
                gty2[i + (i22 + k1) * NX + k * NX * NY].imag = (uu1_real) * (temp_imag) + (uu1_imag) * (temp_real);
            }
        }
        if (l == logd2) {
            for (j1 = 0; j1 < NY; j1++) {

                gty1[i + j1 * NX + k * NX * NY].real = gty2[i + j1 * NX + k * NX * NY].real;
                gty1[i + j1 * NX + k * NX * NY].imag = gty2[i + j1 * NX + k * NX * NY].imag;
            }
        } else {
            n1 = NY / 2;
            lk = 1 << (l + 1 - 1);
            li = 1 << (logd2 - (l + 1));
            lj = 2 * lk;
            ku = li;
            for (i1 = 0; i1 <= li - 1; i1++) {
                for (k1 = 0; k1 <= lk - 1; k1++) {
                    i11 = i1 * lk;
                    i12 = i11 + n1;
                    i21 = i1 * lj;
                    i22 = i21 + lk;

                    uu2_real = u_device[ku + i1].real;
                    uu2_imag = is * u_device[ku + i1].imag;

                    x12_real = gty2[i + (i11 + k1) * NX + k * NX * NY].real;
                    x12_imag = gty2[i + (i11 + k1) * NX + k * NX * NY].imag;

                    x22_real = gty2[i + (i12 + k1) * NX + k * NX * NY].real;
                    x22_imag = gty2[i + (i12 + k1) * NX + k * NX * NY].imag;

                    gty1[i + (i21 + k1) * NX + k * NX * NY].real = x12_real + x22_real;
                    gty1[i + (i21 + k1) * NX + k * NX * NY].imag = x12_imag + x22_imag;

                    temp2_real = x12_real - x22_real;
                    temp2_imag = x12_imag - x22_imag;

                    gty1[i + (i22 + k1) * NX + k * NX * NY].real = (uu2_real) * (temp2_real) - (uu2_imag) * (temp2_imag);
                    gty1[i + (i22 + k1) * NX + k * NX * NY].imag = (uu2_real) * (temp2_imag) + (uu2_imag) * (temp2_real);
                }
            }
        }
    }
}

__global__ void cffts2_gpu_kernel_3(dcomplex x_out[], dcomplex y0[]) {
    int x_y_z = blockIdx.x * blockDim.x + threadIdx.x;
    if (x_y_z >= (NX * NY * NZ)) {
        return;
    }
    x_out[x_y_z].real = y0[x_y_z].real;
    x_out[x_y_z].imag = y0[x_y_z].imag;
}

static void cffts3_gpu(int is, dcomplex u[], dcomplex x_in[], dcomplex x_out[], dcomplex y0[], dcomplex y1[]) {
    cffts3_gpu_kernel_1<<<blocks_per_grid_on_fftz_1, threads_per_block_on_fftz_1>>>(x_in, y0);

    cffts3_gpu_kernel_2<<<blocks_per_grid_on_fftz_2, threads_per_block_on_fftz_2>>>(is, y0, y1, u);

    cffts3_gpu_kernel_3<<<blocks_per_grid_on_fftz_3, threads_per_block_on_fftz_3>>>(x_out, y0);
}

__device__ void cffts3_gpu_cfftz_device(const int is, int m, int n, dcomplex x[], dcomplex y[], dcomplex u_device[], int index_arg, int size_arg) {
    int j, l;

    for (l = 1; l <= m; l += 2) {
        cffts3_gpu_fftz2_device(is, l, m, n, u_device, x, y, index_arg, size_arg);
        if (l == m) {
            break;
        }
        cffts3_gpu_fftz2_device(is, l + 1, m, n, u_device, y, x, index_arg, size_arg);
    }

    if (m % 2 == 1) {
        for (j = 0; j < n; j++) {
            x[j * size_arg + index_arg].real = y[j * size_arg + index_arg].real;
            x[j * size_arg + index_arg].imag = y[j * size_arg + index_arg].imag;
        }
    }
}

__device__ void cffts3_gpu_fftz2_device(const int is, int l, int m, int n, dcomplex u[], dcomplex x[], dcomplex y[], int index_arg, int size_arg) {
    int k, n1, li, lj, lk, ku, i, i11, i12, i21, i22;
    double x11real, x11imag, x21real, x21imag;
    dcomplex u1;

    n1 = n / 2;
    lk = 1 << (l - 1);
    li = 1 << (m - l);
    lj = 2 * lk;
    ku = li;
    for (i = 0; i < li; i++) {
        i11 = i * lk;
        i12 = i11 + n1;
        i21 = i * lj;
        i22 = i21 + lk;
        if (is >= 1) {
            u1.real = u[ku + i].real;
            u1.imag = u[ku + i].imag;
        } else {
            u1.real = u[ku + i].real;
            u1.imag = -u[ku + i].imag;
        }
        for (k = 0; k < lk; k++) {
            x11real = x[(i11 + k) * size_arg + index_arg].real;
            x11imag = x[(i11 + k) * size_arg + index_arg].imag;
            x21real = x[(i12 + k) * size_arg + index_arg].real;
            x21imag = x[(i12 + k) * size_arg + index_arg].imag;
            y[(i21 + k) * size_arg + index_arg].real = x11real + x21real;
            y[(i21 + k) * size_arg + index_arg].imag = x11imag + x21imag;
            y[(i22 + k) * size_arg + index_arg].real = u1.real * (x11real - x21real) - u1.imag * (x11imag - x21imag);
            y[(i22 + k) * size_arg + index_arg].imag = u1.real * (x11imag - x21imag) + u1.imag * (x11real - x21real);
        }
    }
}

__global__ void cffts3_gpu_kernel_1(dcomplex x_in[], dcomplex y0[]) {
    int x_y_z = blockIdx.x * blockDim.x + threadIdx.x;
    if (x_y_z >= (NX * NY * NZ)) {
        return;
    }
    y0[x_y_z].real = x_in[x_y_z].real;
    y0[x_y_z].imag = x_in[x_y_z].imag;
}

__global__ void cffts3_gpu_kernel_2(const int is, dcomplex gty1[], dcomplex gty2[], dcomplex u_device[]) {
    int x_y = blockIdx.x * blockDim.x + threadIdx.x;
    if (x_y >= (NX * NY)) {
        return;
    }
    cffts3_gpu_cfftz_device(is, ilog2_device(NZ), NZ, gty1, gty2, u_device, x_y, NX * NY);
}

__global__ void cffts3_gpu_kernel_3(dcomplex x_out[], dcomplex y0[]) {
    int x_y_z = blockIdx.x * blockDim.x + threadIdx.x;
    if (x_y_z >= (NX * NY * NZ)) {
        return;
    }
    x_out[x_y_z].real = y0[x_y_z].real;
    x_out[x_y_z].imag = y0[x_y_z].imag;
}

static void checksum_gpu(int iteration, dcomplex u1[]) {
    checksum_gpu_kernel<<<blocks_per_grid_on_checksum, threads_per_block_on_checksum, size_shared_data>>>(iteration, u1, sums_device);
}

__global__ void checksum_gpu_kernel(int iteration, dcomplex u1[], dcomplex sums[]) {
    dcomplex *share_sums = (dcomplex *)(extern_share_data);
    int j = (blockIdx.x * blockDim.x + threadIdx.x) + 1, q, r, s;

    if (j <= CHECKSUM_TASKS) {
        q = j % NX;
        r = 3 * j % NY;
        s = 5 * j % NZ;
        share_sums[threadIdx.x] = u1[q + r * NX + s * NX * NY];
    } else {
        share_sums[threadIdx.x] = dcomplex_create(0.0, 0.0);
    }

    __syncthreads();
    for (int i = blockDim.x / 2; i > 0; i >>= 1) {
        if (threadIdx.x < i) {
            share_sums[threadIdx.x] = dcomplex_add(share_sums[threadIdx.x], share_sums[threadIdx.x + i]);
        }
        __syncthreads();
    }
    if (threadIdx.x == 0) {
        share_sums[0].real = share_sums[0].real / (double)(NTOTAL);
        atomicAdd(&sums[iteration].real, share_sums[0].real);
        share_sums[0].imag = share_sums[0].imag / (double)(NTOTAL);
        atomicAdd(&sums[iteration].imag, share_sums[0].imag);
    }
}

static void compute_indexmap_gpu(double twiddle[]) {
    compute_indexmap_gpu_kernel<<<blocks_per_grid_on_compute_indexmap, threads_per_block_on_compute_indexmap>>>(twiddle);
}

__global__ void compute_indexmap_gpu_kernel(double twiddle[]) {
    int thread_id = blockIdx.x * blockDim.x + threadIdx.x;

    if (thread_id >= NTOTAL) {
        return;
    }

    int i = thread_id % NX, j = (thread_id / NX) % NY, k = thread_id / (NX * NY), kk, kk2, jj, kj2, ii;

    kk = ((k + NZ / 2) % NZ) - NZ / 2;
    kk2 = kk * kk;
    jj = ((j + NY / 2) % NY) - NY / 2;
    kj2 = jj * jj + kk2;
    ii = ((i + NX / 2) % NX) - NX / 2;

    twiddle[thread_id] = exp(AP * (double)(ii * ii + kj2));
}

static void compute_initial_conditions_gpu(dcomplex u0[]) {
    double starts[NZ];

    nas_ft_plane_starts(starts, NX, NY, NZ);

    cudaMemcpy(starts_device, starts, size_starts_device, cudaMemcpyHostToDevice);

    compute_initial_conditions_gpu_kernel<<<blocks_per_grid_on_compute_initial_conditions, threads_per_block_on_compute_initial_conditions>>>(u0, starts_device);
}

static void evolve_gpu(dcomplex u0[], dcomplex u1[], double twiddle[]) {
    evolve_gpu_kernel<<<blocks_per_grid_on_evolve, threads_per_block_on_evolve>>>(u0, u1, twiddle);
}

__global__ void evolve_gpu_kernel(dcomplex u0[], dcomplex u1[], double twiddle[]) {
    int thread_id = blockIdx.x * blockDim.x + threadIdx.x;

    if (thread_id >= (NZ * NY * NX)) {
        return;
    }

    u0[thread_id] = dcomplex_mul2(u0[thread_id], twiddle[thread_id]);
    u1[thread_id] = u0[thread_id];
}

static void fft_gpu(int dir, dcomplex x1[], dcomplex x2[]) {

    if (dir == 1) {
        cffts1_gpu(1, u_device, x1, x1, y0_device, y1_device);
        cffts2_gpu(1, u_device, x1, x1, y0_device, y1_device);
        cffts3_gpu(1, u_device, x1, x2, y0_device, y1_device);
    } else {
        cffts3_gpu(-1, u_device, x1, x1, y0_device, y1_device);
        cffts2_gpu(-1, u_device, x1, x1, y0_device, y1_device);
        cffts1_gpu(-1, u_device, x1, x2, y0_device, y1_device);
    }
}

static void fft_init_gpu(int n) {
    int m, ku, i, j, ln;
    double t, ti;

    m = ilog2(n);
    u[0] = dcomplex_create((double)m, 0.0);
    ku = 2;
    ln = 1;
    for (j = 1; j <= m; j++) {
        t = PI / ln;
        for (i = 0; i <= ln - 1; i++) {
            ti = i * t;
            u[i + ku - 1] = dcomplex_create(cos(ti), sin(ti));
        }
        ku = ku + ln;
        ln = 2 * ln;
    }
    cudaMemcpy(u_device, u, size_u_device, cudaMemcpyHostToDevice);
}

static int ilog2(int n) {
    int nn, lg;
    if (n == 1) {
        return 0;
    }
    lg = 1;
    nn = 2;
    while (nn < n) {
        nn = nn << 1;
        lg++;
    }
    return lg;
}

__device__ int ilog2_device(int n) {
    int nn, lg;
    if (n == 1) {
        return 0;
    }
    lg = 1;
    nn = 2;
    while (nn < n) {
        nn = nn << 1;
        lg++;
    }
    return lg;
}

static void init_ui_gpu(dcomplex u0[], dcomplex u1[], double twiddle[]) {
    init_ui_gpu_kernel<<<blocks_per_grid_on_init_ui, threads_per_block_on_init_ui>>>(u0, u1, twiddle);
    cudaDeviceSynchronize();
}

__global__ void init_ui_gpu_kernel(dcomplex u0[], dcomplex u1[], double twiddle[]) {
    int thread_id = blockIdx.x * blockDim.x + threadIdx.x;

    if (thread_id >= NTOTAL) {
        return;
    }

    u0[thread_id] = dcomplex_create(0.0, 0.0);
    u1[thread_id] = dcomplex_create(0.0, 0.0);
    twiddle[thread_id] = 0.0;
}

static void setup_gpu() {
    threads_per_block_on_compute_indexmap = 32;
    threads_per_block_on_compute_initial_conditions = 32;
    threads_per_block_on_init_ui = 32;
    threads_per_block_on_evolve = 32;
    threads_per_block_on_fftx_1 = 1024;
    threads_per_block_on_fftx_2 = 32;
    threads_per_block_on_fftx_3 = 256;
    threads_per_block_on_ffty_1 = 32;
    threads_per_block_on_ffty_2 = 32;
    threads_per_block_on_ffty_3 = 32;
    threads_per_block_on_fftz_1 = 32;
    threads_per_block_on_fftz_2 = 32;
    threads_per_block_on_fftz_3 = 32;
    threads_per_block_on_checksum = 32;
    blocks_per_grid_on_compute_indexmap = ceil(double(NTOTAL) / double(threads_per_block_on_compute_indexmap));
    blocks_per_grid_on_compute_initial_conditions = ceil(double(NZ) / double(threads_per_block_on_compute_initial_conditions));
    blocks_per_grid_on_init_ui = ceil(double(NTOTAL) / double(threads_per_block_on_init_ui));
    blocks_per_grid_on_evolve = ceil(double(NTOTAL) / double(threads_per_block_on_evolve));
    blocks_per_grid_on_fftx_1 = ceil(double(NX * NY * NZ) / double(threads_per_block_on_fftx_1));
    blocks_per_grid_on_fftx_2 = ceil(double(NY * NZ) / double(threads_per_block_on_fftx_2));
    blocks_per_grid_on_fftx_3 = ceil(double(NX * NY * NZ) / double(threads_per_block_on_fftx_3));
    blocks_per_grid_on_ffty_1 = ceil(double(NX * NY * NZ) / double(threads_per_block_on_ffty_1));
    blocks_per_grid_on_ffty_2 = ceil(double(NX * NZ) / double(threads_per_block_on_ffty_2));
    blocks_per_grid_on_ffty_3 = ceil(double(NX * NY * NZ) / double(threads_per_block_on_ffty_3));
    blocks_per_grid_on_fftz_1 = ceil(double(NX * NY * NZ) / double(threads_per_block_on_fftz_1));
    blocks_per_grid_on_fftz_2 = ceil(double(NX * NY) / double(threads_per_block_on_fftz_2));
    blocks_per_grid_on_fftz_3 = ceil(double(NX * NY * NZ) / double(threads_per_block_on_fftz_3));
    blocks_per_grid_on_checksum = ceil(double(CHECKSUM_TASKS) / double(threads_per_block_on_checksum));

    size_sums_device = (NITER_DEFAULT + 1) * sizeof(dcomplex);
    size_starts_device = NZ * sizeof(double);
    size_twiddle_device = NTOTAL * sizeof(double);
    size_u_device = MAXDIM * sizeof(dcomplex);
    size_u0_device = NTOTAL * sizeof(dcomplex);
    size_u1_device = NTOTAL * sizeof(dcomplex);
    size_y0_device = NTOTAL * sizeof(dcomplex);
    size_y1_device = NTOTAL * sizeof(dcomplex);
    size_shared_data = threads_per_block_on_checksum * sizeof(dcomplex);

    cudaMalloc(&sums_device, size_sums_device);
    cudaMalloc(&starts_device, size_starts_device);
    cudaMalloc(&twiddle_device, size_twiddle_device);
    cudaMalloc(&u_device, size_u_device);
    cudaMalloc(&u0_device, size_u0_device);
    cudaMalloc(&u1_device, size_u1_device);
    cudaMalloc(&y0_device, size_y0_device);
    cudaMalloc(&y1_device, size_y1_device);

    cudaMemset(sums_device, 0, size_sums_device);

    omp_set_num_threads(OMP_THREADS);
}
